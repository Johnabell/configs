# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

plugins=(git)

# Agent detection — set before sourcing Oh My Zsh so the theme applies
if [[ -n "$npm_config_yes" ]] || [[ -n "$CI" ]] || [[ "$-" != *i* ]]; then
  export AGENT_MODE=true
else
  export AGENT_MODE=false
fi

if [[ "$AGENT_MODE" == "true" ]]; then
  export DEBIAN_FRONTEND=noninteractive
  export NONINTERACTIVE=1
  ZSH_THEME=""
else
  ZSH_THEME="robbyrussell"
fi

# Prefer nvim when available
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-nvim}"

# Ensure common user bins are on PATH early
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Homebrew curl/jq shims when present (macOS)
if command -v brew >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix 2>/dev/null || true)"
  if [[ -n "$brew_prefix" ]]; then
    export PATH="$brew_prefix/opt/curl/bin:$PATH"
  fi
fi

# bat is installed as batcat on some Debian/Ubuntu images
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat=batcat
fi

fpath=("$HOME/.zsh/completions" $fpath)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

autoload -U compinit && compinit

export FZF_DEFAULT_COMMAND='rg --files --hidden'

# GKE credential helpers (require gcloud on PATH)
alias kls="gcloud container clusters get-credentials prd-usc1-gke-cluster --region us-central1 --project prd-usc1"
alias kld="gcloud container clusters get-credentials internal --region us-central1 --project fathom-internal"
alias kle="gcloud container clusters get-credentials stg-eun1-gke-cluster --region europe-north1 --project prd-usc1"
alias pa="pipeline-cli"

# ssh-agent (portable; macOS keychain only when available)
if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
  eval "$(ssh-agent -s)" >/dev/null
  if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
    if ssh-add --apple-use-keychain "$HOME/.ssh/id_ed25519" 2>/dev/null; then
      :
    else
      ssh-add "$HOME/.ssh/id_ed25519" 2>/dev/null || true
    fi
  fi
fi

if [[ "$AGENT_MODE" == "true" ]]; then
  PROMPT='%n@%m:%~%# '
  RPROMPT=''
  unsetopt CORRECT
  unsetopt CORRECT_ALL
  setopt NO_BEEP
  setopt NO_HIST_BEEP
  setopt NO_LIST_BEEP
fi

# asdf-java: export JAVA_HOME when the plugin is installed
if [[ -f "$HOME/.asdf/plugins/java/set-java-home.zsh" ]]; then
  . "$HOME/.asdf/plugins/java/set-java-home.zsh"
fi

# Machine-local secrets and overrides (never commit this file)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
